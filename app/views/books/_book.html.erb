<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= book.author %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= book.category.name rescue "Sem categoria!" %>
    </p>
  </div>

  <div>
    <strong>Status:</strong>
    <%= book.status %>
  </div>

  <div>
    <strong>Notes:</strong>
    <%= book.notes %>
  </div>

</div>
