<%= form_with(model: book) do |form| %>
  <% if book.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(book.errors.count, "erro") %> impediram este livro de ser salvo:</h2>
      <ul>
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", style: "display: block" %>
    <%= form.text_field :title, required: true %>
  </div>

  <br>

  <div>
    <%= form.label :author, "Autor", style: "display: block" %>
    <%= form.text_field :author, required: true %>
  </div>

  <br>

  <div>
    <%= form.label :category_id, "Categoria", style: "display: block" %>
    <%= form.collection_select :category_id, Category.all, :id, :name, prompt: "Selecione a categoria" %>
  </div>

  <br>

  <div>
    <%= form.label :status, "Status do Livro", style: "display: block" %>
    <%= form.select :status, [["Disponível", "Disponível"], ["Emprestado", "Emprestado"]], prompt: "Selecione o status" %>
  </div>

  <br>

  <div>
    <%= form.submit "Salvar Livro" %>
  </div>
<% end %>