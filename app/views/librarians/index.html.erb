<p style="color: green"><%= notice %></p>

<% content_for :title, "Librarians" %>

<h1>Librarians</h1>

<div id="librarians">
  <% @librarians.each do |librarian| %>
    <%= render librarian %>
    <p>
      <%= link_to "Show this librarian", librarian %>
    </p>
  <% end %>
</div>

<%= link_to "New librarian", new_librarian_path %>
