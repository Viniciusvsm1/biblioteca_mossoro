<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Biblioteca Mossoro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Biblioteca Mossoro">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

   
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">


    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div style="position: absolute; top: 15px; right: 25px; z-index: 1000;">
  <img src="/logo.png" alt="Biblioteca Ney Pontes" style="height: 65px; width: auto;">
</div>
    <nav style="background: #f0f0f0; padding: 10px; margin-bottom: 20px; font-family: sans-serif;">
    <strong>Biblioteca Ney Pontes:</strong> | 
    <%= link_to "Empréstimos", loans_path %> | 
    <%= link_to "Livros", books_path %> | 
    <%= link_to "Categorias", categories_path %> | 
    <%= link_to "Leitores", readers_path %> | 
    <%= link_to "Bibliotecários", librarians_path %>
  </nav
    <%= yield %>
  </body>
</html>
